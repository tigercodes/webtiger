<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- A browser's own: the network, and whether there is one (a lookup that fails with no
         network is reported as "offline"). Both are granted at install. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- What a page may ask to use (014): the camera, the microphone, where the device is. None
         is held until the system has asked the person, which happens the first time a site the
         person allowed needs it, and not before. MODIFY_AUDIO_SETTINGS is the WebView's, for
         a microphone; it is granted at install. No part of the device is required: the app
         installs on one without a camera. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <!-- allowBackup is off, and dataExtractionRules excludes everything: the store and the
         WebView's profiles hold cookies and history, and whether any of it may leave the device
         is a decision not yet taken.
         usesCleartextTraffic is on: a browser loads http pages too; the address field says
         "not secure" for them. -->
    <application
        android:name=".WebTigerApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.WebTiger"
        android:usesCleartextTraffic="true">
        <!-- configChanges: the activity is not recreated when the window's size, the fold, the
             density, the keyboard, the theme or the language changes (000 §6.5). Compose
             redraws; the web views, held outside the composition, keep their pages.
             launchMode singleTask: there is one window, however it is asked for. Started
             again (its icon, words another app handed over, 028, or a link pressed in another
             app, 031), the one there is comes forward and is told; without this the system puts
             a second window on top of the first whenever the two starts differ.
             The second filter is the way in for a link pressed in another app (031): the
             system's "view" for an address of the web, of any site, which is what makes the
             system count WebTiger among the browsers. The window answers it itself: every such
             request reaches the one window, in order, however fast they come (an activity put
             in front of it to carry the address was not always started when several came at
             once: seen on the emulator). Whether an address is one to open is the core's to
             say: only http and https are, whatever is handed over. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|navigation|uiMode|fontScale|layoutDirection|locale"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>
        <!-- For a search for words that are selected in a page (023). The WebView's bar for
             selected text offers "Web search" only when it can see something that answers a
             web search; this is the app's own answerer. It is not exported: no other app sees
             it or can start it. It is never shown: the adapter hears the WebView's request and
             tells the core, which searches with the engine the person chose
             (webview/SearchingContext.kt). -->
        <activity
            android:name=".webview.SearchSelectionActivity"
            android:exported="false"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.WEB_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- "Search with WebTiger" in other apps' menu of selected text (028): the system's
             "process this text". Exported: being started by other apps is what it is for. It
             shows nothing: it hands the words to the app's window, to be searched for with the
             engine the person chose, and goes. The words are never anything but a search.
             Its label is the item's name in the menu.
             taskAffinity is empty: it is never part of the window's task, whoever starts it
             and however. As the first thing in that task, it made the system take a second
             request for the first one over again, and start nothing (seen on the emulator). -->
        <activity
            android:name=".SearchWordsActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/outside_search"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
