<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing the app keeps is copied off the device, to a cloud backup or to a new phone: the
     store and the WebView's profiles hold cookies and history, and whether any of it may leave
     the device is a decision not yet taken. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
