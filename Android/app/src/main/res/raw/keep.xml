<?xml version="1.0" encoding="utf-8"?>
<!-- The words for a core error code are found by name (ui/Words.kt: "net.dns" is error_net_dns),
     and so are the words for a colour a Space can have (ui/SpaceColours.kt: "blue" is
     space_colour_blue) and for a time its tabs are tidied after (ui/SpaceTidying.kt: 43200 is
     space_tidy_43200), which resource shrinking cannot see. -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@string/error_*,@string/space_colour_*,@string/space_tidy_*" />
