    "certificate.advanced": {
      "comment": "Button on the page shown when a site's certificate isn't trusted, under 'Try Again': shows the warning, and under it the way to go on to the site all the same.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Advanced…"
          }
        }
      }
    },
    "certificate.proceed": {
      "comment": "Button under the warning: loads the site although its certificate isn't trusted. %@ is the site's host name. The words in brackets say what the button does and must stay.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go On to %@ (Not Safe)"
          }
        }
      }
    },
    "certificate.warning": {
      "comment": "The warning shown before a person can go on to a site whose certificate isn't trusted. %@ is the site's host name, such as router.example.com.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WebTiger can’t confirm that this is really %@. Someone could be pretending to be it, and could read or change what you send and receive: passwords, messages, card numbers."
          }
        }
      }
    },
    "certificate.warning.only_if": {
      "comment": "Second sentence of the warning before going on to a site whose certificate isn't trusted.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go on only if you know why this site’s certificate isn’t trusted, such as a router or a device of your own."
          }
        }
      }
    },
    "certificate.warning.title": {
      "comment": "Heading of the warning shown before a person can go on to a site whose certificate isn't trusted.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Going on isn’t safe"
          }
        }
      }
    },
    "downloads.active": {
      "comment": "Accessibility value of the History and Downloads button while a download is coming.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloading"
          }
        }
      }
    },
    "downloads.clear": {
      "comment": "Button in the Downloads list that takes every download off the list. The files stay where they are.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear List"
          }
        }
      }
    },
    "downloads.coming": {
      "comment": "Under a download that is still coming, when its size is known: how much has arrived, and how much there is. Both are sizes with their units, such as “1.2 MB”.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ of %2$@"
          }
        }
      }
    },
    "downloads.coming_so_far": {
      "comment": "Under a download that is still coming, when its size is not known: how much has arrived, as a size with its unit.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ so far"
          }
        }
      }
    },
